{
   "name": "better-convex-auth",
   "version": "0.0.1",
   "private": true,
   "scripts": {
      "build": "turbo build",
      "dev": "turbo dev --filter=web --filter=@workspace/backend",
      "dev:full": "turbo dev",
      "dev:typecheck": "turbo typecheck --watch",
      "typecheck": "turbo typecheck",
      "format": "biome format --write .",
      "check": "biome check .",
      "setup": "./scripts/setup-dev.sh",
      "benchmark": "node scripts/benchmark-build.js",
      "upgrade:all": "pnpm -r up --latest"
   },
   "devDependencies": {
      "@biomejs/biome": "2.3.4",
      "@workspace/typescript-config": "workspace:*",
      "prettier": "^3.6.2",
      "turbo": "^2.6.0",
      "typescript": "5.9.3"
   },
   "packageManager": "pnpm@10.4.1",
   "engines": {
      "node": ">=20"
   },
   "pnpm": {
      "overrides": {
         "tmp@<=0.2.3": ">=0.2.4"
      }
   }
}
