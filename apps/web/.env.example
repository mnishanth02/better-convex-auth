# Convex Backend URL
# Get this from: npx convex dev (or your Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=

# Convex Site URL (used for auth routes and file downloads)
# Get this from: npx convex dev (or your Convex dashboard)
NEXT_PUBLIC_CONVEX_SITE_URL=

# Site URL (for auth callbacks and redirects)
# In development: http://localhost:3000
# In production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth Providers (Optional)
# Get these from your OAuth provider's developer console

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Resend (for email verification)
RESEND_API_KEY=
