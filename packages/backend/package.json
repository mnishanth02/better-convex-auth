{
  "name": "@workspace/backend",
  "type": "module",
  "version": "1.0.0",
  "description": "Convex Database and Functions for Turborepo app",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "predev": "convex dev --until-success --once",
    "typecheck": "tsc --noEmit --project convex/tsconfig.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf .turbo node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./convex/*": "./convex/*"
  },
  "keywords": [],
  "author": "Nishanth Murugan",
  "license": "ISC",
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@auth/core": "workspace:*",
    "@auth/utils": "workspace:^",
    "@convex-dev/better-auth": "^0.9.7",
    "@convex-dev/rate-limiter": "^0.2.14",
    "@convex-dev/resend": "^0.1.13",
    "better-auth": "1.3.34",
    "convex": "^1.28.2",
    "convex-helpers": "^0.1.104"
  }
}
