{
  "name": "@workspace/z-auth",
  "version": "1.0.0",
  "description": "Unified auth package for Better Convex Auth - one package to rule them all",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./nextjs": {
      "types": "./src/nextjs/index.ts",
      "import": "./src/nextjs/index.ts"
    },
    "./nextjs/handler": {
      "types": "./src/nextjs/handler.ts",
      "import": "./src/nextjs/handler.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./backend": {
      "types": "./src/backend/index.ts",
      "import": "./src/backend/index.ts"
    },
    "./templates/*": "./templates/*",
    "./*": null
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.9.7",
    "better-auth": "^1.3.34",
    "convex": "^1.28.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@workspace/typescript-config": "workspace:*",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.0.0",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.400.0",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "keywords": [
    "auth",
    "authentication",
    "convex",
    "better-auth",
    "nextjs",
    "react",
    "turborepo",
    "monorepo"
  ]
}
