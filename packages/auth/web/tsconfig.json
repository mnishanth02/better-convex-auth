{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "dist",
    "rootDir": "src",
    "declarationDir": "dist",
    // Override module resolution for source-only package consumed by Next.js
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../utils"
    }
  ]
}
