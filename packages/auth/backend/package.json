{
  "name": "@auth/backend",
  "version": "0.1.0",
  "description": "Backend authentication utilities and factory functions for Better Convex Auth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": null,
    "./src/*": null,
    "./internal/*": null,
    "./*": null
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "auth",
    "authentication",
    "backend",
    "better-auth",
    "convex",
    "server",
    "typescript"
  ],
  "author": "Better Convex Auth Team",
  "license": "MIT",
  "dependencies": {
    "@auth/core": "workspace:*",
    "@auth/types": "workspace:*",
    "@convex-dev/better-auth": "^0.9.7",
    "@convex-dev/resend": "^0.1.13",
    "better-auth": "^1.3.34",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "convex": "^1.28.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
