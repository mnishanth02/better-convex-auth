{
   "$schema": "https://turbo.build/schema.json",
   "ui": "tui",
   "globalDependencies": [".env*", "tsconfig.json"],
   "globalEnv": ["NODE_ENV"],
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "inputs": [
            "$TURBO_DEFAULT$",
            ".env*",
            "tsconfig.json",
            "package.json"
         ],
         "outputs": [
            ".next/**",
            "!.next/cache/**",
            "dist/**",
            "*.tsbuildinfo",
            ".tsbuildinfo"
         ],
         "cache": true
      },
      "lint": {
         "dependsOn": ["^lint"],
         "inputs": ["$TURBO_DEFAULT$", "biome.json"],
         "cache": true
      },
      "check-types": {
         "dependsOn": ["^check-types"],
         "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
         "outputs": ["*.tsbuildinfo", ".tsbuildinfo"],
         "cache": true
      },
      "typecheck": {
         "dependsOn": ["^typecheck"],
         "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
         "outputs": ["dist/.tsbuildinfo"],
         "cache": true
      },
      "dev": {
         "cache": false,
         "persistent": true
      }
   }
}
