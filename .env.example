# ====================
# Convex Configuration
# ====================
# Your Convex deployment URL (get this from https://dashboard.convex.dev)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex deployment name (format: dev:your-team:your-project or prod:your-team:your-project)
CONVEX_DEPLOYMENT=dev:your-team:your-project

# ====================
# Application URLs
# ====================
# Base URL of your application (used for auth redirects and email links)
# Development: http://localhost:3000
# Production: https://yourdomain.com
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ====================
# Better Auth
# ====================
# Secret key for Better Auth (generate with: openssl rand -base64 32)
# IMPORTANT: Keep this secret and never commit it to version control
BETTER_AUTH_SECRET=your-secret-key-here-use-openssl-rand-base64-32

# Better Auth base URL (should match SITE_URL)
BETTER_AUTH_URL=http://localhost:3000

# ====================
# Email Service (Resend)
# ====================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email sender address (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ====================
# OAuth - Google
# ====================
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ====================
# OAuth - Apple (Optional)
# ====================
# Get these from https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# ====================
# Development/Production
# ====================
NODE_ENV=development

# ====================
# NOTES:
# ====================
# 1. Copy this file to .env.local and fill in your actual values
# 2. NEVER commit .env.local to version control (it's in .gitignore)
# 3. For production, set these as environment variables in your hosting platform
# 4. Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
# 5. All NEXT_PUBLIC_* variables are exposed to the browser
